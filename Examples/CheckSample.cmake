# Helpers for the scripts that run a sample as a test: cmake -DEXAMPLE=<executable> -P <script>

# runs the sample, fails unless it exits with 0, and returns its output
function(run_example output)
    execute_process(COMMAND "${EXAMPLE}" RESULT_VARIABLE exit_code
                    OUTPUT_VARIABLE out ERROR_VARIABLE errors)
    message("${out}${errors}")
    if(NOT exit_code EQUAL 0)
        message(FATAL_ERROR "the example exited with ${exit_code}")
    endif()
    string(REPLACE "\r" "" out "${out}")
    set(${output} "${out}" PARENT_SCOPE)
endfunction()

# a fixed-point number as an integer in units of its last digit, as cmake has no
# floating point; thousands separators are dropped
function(to_units number result)
    string(REGEX REPLACE "[.,]" "" digits "${number}")
    string(REGEX REPLACE "^(-?)0+([0-9])" "\\1\\2" digits "${digits}")
    set(${result} ${digits} PARENT_SCOPE)
endfunction()

# |value| for an integer
function(absolute number result)
    if(number LESS 0)
        math(EXPR number "0 - ${number}")
    endif()
    set(${result} ${number} PARENT_SCOPE)
endfunction()

# fails unless two fixed-point numbers with the same decimals differ by at most
# allowed, in units of their last digit; label says what is checked and the tolerance
function(check_close label value reference allowed)
    to_units(${value} v)
    to_units(${reference} r)
    math(EXPR difference "${v} - ${r}")
    absolute(${difference} difference)
    if(difference GREATER allowed)
        message(FATAL_ERROR "${label}: ${value} differs from ${reference}")
    endif()
endfunction()

# fails unless value is within tolerance (like 5e-4) of reference, relative to the
# reference, or within floor units of the last digit where that allows more
function(check_relative_close label value reference tolerance floor)
    if(NOT tolerance MATCHES "^([0-9]+)e-([0-9]+)$")
        message(FATAL_ERROR "${label}: tolerance ${tolerance} is not like 5e-4")
    endif()
    set(mantissa ${CMAKE_MATCH_1})
    string(REPEAT 0 ${CMAKE_MATCH_2} zeros)
    to_units(${reference} r)
    absolute(${r} r)
    math(EXPR allowed "${r} * ${mantissa} / 1${zeros}")
    if(allowed LESS floor)
        set(allowed ${floor})
    endif()
    check_close("${label} (within ${tolerance})" ${value} ${reference} ${allowed})
endfunction()

# fails unless a number in scientific notation, like 1.6e-05, is at most 10^-digits
# times another one
function(check_relative label number largest digits)
    if(NOT largest MATCHES "^([0-9.]+)e([-+][0-9]+)$")
        message(FATAL_ERROR "${label}: ${largest} is not in scientific notation")
    endif()
    math(EXPR exponent "${CMAKE_MATCH_2} - ${digits}")
    set(bound "${CMAKE_MATCH_1}e${exponent}")
    if(NOT number LESS_EQUAL bound)
        message(FATAL_ERROR "${label}: ${number} is more than 1e-${digits} times ${largest}")
    endif()
endfunction()

# a number as iostreams print it by default (like 48.6724, -3.5e-07 or 0) as an
# integer in units of 1e-9, digits beyond those dropped; also sets <result>_unit to
# one unit of the number's last printed digit, in the same units
function(to_nano number result)
    if(NOT number MATCHES "^(-?)([0-9]+)\\.?([0-9]*)(e([-+]?)0*([0-9]+))?$")
        message(FATAL_ERROR "${number} is not a number")
    endif()
    set(sign "${CMAKE_MATCH_1}")
    set(digits "${CMAKE_MATCH_2}${CMAKE_MATCH_3}")
    string(LENGTH "${CMAKE_MATCH_3}" decimals)
    set(exponent 0)
    if(CMAKE_MATCH_4)
        set(exponent "${CMAKE_MATCH_6}")
        if(CMAKE_MATCH_5 STREQUAL "-")
            set(exponent "-${exponent}")
        endif()
    endif()
    math(EXPR shift "9 + ${exponent} - ${decimals}")
    if(shift GREATER_EQUAL 0)
        string(REPEAT 0 ${shift} zeros)
        string(APPEND digits "${zeros}")
        set(unit "1${zeros}")
    else()
        string(LENGTH "${digits}" length)
        math(EXPR length "${length} + ${shift}")
        if(length GREATER 0)
            string(SUBSTRING "${digits}" 0 ${length} digits)
        else()
            set(digits 0)
        endif()
        set(unit 1)
    endif()
    string(REGEX REPLACE "^0+" "" digits "${digits}")
    string(LENGTH "${digits}" length)
    if(length GREATER 18)
        message(FATAL_ERROR "${number} is too large to check")
    endif()
    if(digits STREQUAL "")
        set(digits 0)
    elseif(sign)
        set(digits "-${digits}")
    endif()
    set(${result} ${digits} PARENT_SCOPE)
    set(${result}_unit ${unit} PARENT_SCOPE)
endfunction()

# fails unless value is within tolerance (like 5e-4) of reference, relative to the
# reference, or within floor (like 1e-3, or 0) absolutely where that allows more;
# both are printed with iostreams' default format, so a non-zero reference may also
# differ by one unit of its last digit, the rounding of the print
function(check_printed_close label value reference tolerance floor)
    if(NOT tolerance MATCHES "^([0-9]+)e-([0-9]+)$")
        message(FATAL_ERROR "${label}: tolerance ${tolerance} is not like 5e-4")
    endif()
    set(mantissa ${CMAKE_MATCH_1})
    string(REPEAT 0 ${CMAKE_MATCH_2} zeros)
    to_nano(${value} v)
    to_nano(${reference} r)
    to_nano(${floor} allowed)
    absolute(${r} size)
    math(EXPR relative "${size} * ${mantissa} / 1${zeros}")
    if(relative GREATER allowed)
        set(allowed ${relative})
    endif()
    if(NOT r EQUAL 0 AND r_unit GREATER allowed)
        set(allowed ${r_unit})
    endif()
    math(EXPR difference "${v} - ${r}")
    absolute(${difference} difference)
    if(difference GREATER allowed)
        message(FATAL_ERROR
                "${label}: ${value} differs from ${reference} (within ${tolerance}, floor ${floor})")
    endif()
endfunction()
