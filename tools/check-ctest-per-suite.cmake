cmake_minimum_required(VERSION 3.19)  # policies for cmake -P (IN_LIST, string(JSON))

# Checks that a QuantLib build directory registers each of QuantLib's Boost.Test suites as
# its own CTest test, named QuantLibTests/<Suite>, so that ctest -j runs them in parallel, each only
# its suite, in the C locale and with a timeout, with QuantLib's own quantlib_test_suite test
# disabled, and with the scanned test sources as configure dependencies. With TEST_BINARY (the built
# quantlib-test-suite), the suites are those its --list_content shows. PER_SUITE=OFF
# (QL_ENABLE_PARALLEL_UNIT_TEST_RUNNER=ON) expects none, and quantlib_test_suite enabled.
#
#   cmake -DBUILD_DIR=<QuantLib build dir> [-DPER_SUITE=OFF] [-DTEST_BINARY=<path>] [-DNINJA_DIR=<top build dir>] -P tools/check-ctest-per-suite.cmake

if(NOT BUILD_DIR)
    message(FATAL_ERROR "usage: cmake -DBUILD_DIR=<QuantLib build dir> [-DPER_SUITE=OFF] -P ${CMAKE_CURRENT_LIST_FILE}")
endif()
if(NOT DEFINED PER_SUITE)
    set(PER_SUITE ON)
endif()

execute_process(COMMAND ${CMAKE_CTEST_COMMAND} --show-only=json-v1
                WORKING_DIRECTORY ${BUILD_DIR}
                OUTPUT_VARIABLE json RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "ctest --show-only failed (${rc}):\n${json}")
endif()

string(JSON ntests LENGTH "${json}" tests)
if(ntests EQUAL 0)
    message(FATAL_ERROR "no ctest tests at all in ${BUILD_DIR}")
endif()
set(n 0)
set(registered)
set(whole_suite_disabled OFF)
math(EXPR last "${ntests} - 1")
foreach(i RANGE ${last})
    string(JSON name GET "${json}" tests ${i} name)
    set(env "")
    set(timeout "")
    set(disabled OFF)
    string(JSON nprops ERROR_VARIABLE err LENGTH "${json}" tests ${i} properties)
    if(nprops GREATER 0)
        math(EXPR plast "${nprops} - 1")
        foreach(j RANGE ${plast})
            string(JSON pname GET "${json}" tests ${i} properties ${j} name)
            string(JSON pvalue GET "${json}" tests ${i} properties ${j} value)
            if(pname STREQUAL "ENVIRONMENT")
                set(env "${pvalue}")
            elseif(pname STREQUAL "TIMEOUT")
                set(timeout "${pvalue}")
            elseif(pname STREQUAL "DISABLED")
                set(disabled "${pvalue}")
            endif()
        endforeach()
    endif()
    if(name STREQUAL "quantlib_test_suite")
        set(whole_suite_disabled ${disabled})
    endif()
    if(NOT name MATCHES "^QuantLibTests/[A-Za-z0-9_]+$")
        continue()
    endif()
    math(EXPR n "${n} + 1")
    string(REGEX REPLACE "^QuantLibTests/" "" suite "${name}")
    list(APPEND registered ${suite})
    if(NOT env MATCHES "LC_ALL=C" OR NOT timeout GREATER 0)
        message(FATAL_ERROR "${name}: expected LC_ALL=C and a timeout, found ENVIRONMENT '${env}', TIMEOUT '${timeout}'")
    endif()
    if(name STREQUAL "QuantLibTests/AmericanOptionTests")
        set(american ON)
    endif()
endforeach()

if(NOT PER_SUITE)
    if(n GREATER 0 OR whole_suite_disabled)
        message(FATAL_ERROR "expected no QuantLibTests/<Suite> ctest tests and quantlib_test_suite enabled, found ${n} (quantlib_test_suite disabled: ${whole_suite_disabled})")
    endif()
    message(STATUS "no QuantLibTests/<Suite> ctest tests, quantlib_test_suite enabled")
    return()
endif()
# each runs only its suite (the commands as CTestTestfile.cmake has them, the binary needn't exist)
file(GLOB_RECURSE testfiles "${BUILD_DIR}/CTestTestfile.cmake")
set(add_tests "")
foreach(f IN LISTS testfiles)
    file(STRINGS ${f} lines REGEX "^add_test\\((\\[=\\[)?QuantLibTests/")
    list(APPEND add_tests ${lines})
endforeach()
foreach(line IN LISTS add_tests)
    string(REGEX MATCH "^add_test\\((\\[=\\[)?QuantLibTests/([A-Za-z0-9_]+)" _ "${line}")
    set(suite ${CMAKE_MATCH_2})
    string(REGEX MATCHALL "--run_test=[^\" ]*" run_tests "${line}")
    if(NOT run_tests STREQUAL "--run_test=QuantLibTests/${suite}")
        message(FATAL_ERROR "QuantLibTests/${suite}: expected to run only its suite, runs '${run_tests}'")
    endif()
endforeach()
list(LENGTH add_tests nadd)
if(NOT nadd EQUAL n)
    message(FATAL_ERROR "${n} QuantLibTests/<Suite> tests, but ${nadd} of their add_test lines found")
endif()
if(NOT whole_suite_disabled)
    message(FATAL_ERROR "quantlib_test_suite is enabled next to the per-suite tests")
endif()
if(NOT DEFINED NINJA_DIR)   # the top build dir, when QuantLib is a subproject
    set(NINJA_DIR ${BUILD_DIR})
endif()
file(STRINGS ${NINJA_DIR}/build.ninja rerun REGEX "^build build\\.ninja")
if(NOT rerun MATCHES "/test-suite/americanoption\\.cpp")
    message(FATAL_ERROR "the scanned test sources are no configure dependencies: ${rerun}")
endif()
if(DEFINED TEST_BINARY)
    execute_process(COMMAND ${TEST_BINARY} --list_content OUTPUT_VARIABLE lc ERROR_VARIABLE lc RESULT_VARIABLE rc)
    string(REGEX MATCHALL "\n    [A-Za-z0-9_]+" listed "\n${lc}")
    list(TRANSFORM listed REPLACE "^\n    " "")
    list(SORT listed)
    list(SORT registered)
    if(NOT listed STREQUAL registered)
        message(FATAL_ERROR "registered suites differ from ${TEST_BINARY} --list_content:\n${registered}\n${listed}")
    endif()
    list(LENGTH listed nl)
    set(listed_msg ", as --list_content (${nl})")
endif()
if(n LESS 100)
    message(FATAL_ERROR "expected at least 100 QuantLibTests/<Suite> ctest tests, found ${n}")
endif()
if(NOT american)
    message(FATAL_ERROR "no ctest test QuantLibTests/AmericanOptionTests")
endif()
message(STATUS "${n} QuantLibTests/<Suite> ctest tests${listed_msg}, each its suite, in the C locale and with a timeout")
